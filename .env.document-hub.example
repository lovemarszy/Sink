# Minimal Document Hub production profile.
# Copy to ignored .env.production and replace the empty resource values.
# Do not store production passwords or management keys in this file.
DEPLOY_DOCUMENT_HUB=true
DEPLOY_WORKER_NAME=document-hub
DEPLOY_ACCOUNT_ID=
DEPLOY_D1_DATABASE_NAME=document-hub-db
DEPLOY_D1_DATABASE_ID=
DEPLOY_KV_NAMESPACE_ID=

# Leave empty for the first upload; attach a hostname only after secrets are set.
DEPLOY_CUSTOM_DOMAIN=

# The profile enforces HTTPS, request limits, authoritative D1 redirects,
# disabled analytics/proxy/demo/CORS, no AI/R2/cron, and no public preview URLs.
# Set NUXT_SITE_TOKEN and NUXT_DIRECTORY_PASSWORD using wrangler secret put.
